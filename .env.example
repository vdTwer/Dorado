# Copy to .env and fill in. Docker Compose reads .env automatically.

# Your host user id, so files written to ./data and ./logs belong to you.
# Linux: run `id -u`. macOS can keep the default.
AIRFLOW_UID=50000

# Encrypts connection passwords in the metadata database. Generate one with:
#   uv run python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AIRFLOW_FERNET_KEY=

# Signs the tokens that tasks use to talk to the API server. Generate one with:
#   openssl rand -hex 32
AIRFLOW_JWT_SECRET=
